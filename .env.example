# ---------------------------------------------
# Veritabanı (Prisma Postgres / Vercel Postgres)
# ---------------------------------------------
DATABASE_URL="postgresql://KULLANICI:SIFRE@HOST:5432/VERITABANI?sslmode=require"

# ---------------------------------------------
# Google Gemini API anahtarı
# https://aistudio.google.com/app/apikey adresinden alınır.
# SADECE sunucu tarafında kullanılır, istemciye gönderilmez.
# ---------------------------------------------
GEMINI_API_KEY="buraya-gemini-api-anahtarinizi-yazin"

# ---------------------------------------------
# NextAuth.js v5 (Auth.js)
# AUTH_SECRET üretmek için (herhangi bir paket kurmadan):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Alternatif: npx auth secret
# ---------------------------------------------
AUTH_SECRET="rastgele-uzun-bir-gizli-anahtar"
AUTH_URL="http://localhost:3000"
